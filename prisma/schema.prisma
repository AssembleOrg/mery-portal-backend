// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUBADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  firstName String?
  lastName  String?
  phone     String?
  country   String?
  city      String?
  isActive  Boolean  @default(true)

  // Email verification
  isEmailVerified           Boolean   @default(false)
  emailVerificationToken    String?
  emailVerificationExpires  DateTime?
  lastVerificationEmailSent DateTime?

  // Password reset
  passwordResetToken         String?
  passwordResetExpires       DateTime?
  lastPasswordResetEmailSent DateTime?

  // Relations
  categoryPurchases CategoryPurchase[]
  videoViews        VideoView[]
  cart              Cart?
  presencialVotes   PresencialVote[]
  chatRooms         ChatRoom[]
  chatMessages      ChatMessage[]
  quizAttempts      QuizAttempt[]
  chatTokenEvents   ChatTokenEvent[]   @relation("ChatTokenEventAdmin")
  coupons           Coupon[]           @relation("UserCoupons")
  mentorships       Mentorship[]
  mentorshipCredits MentorshipCredit[]
  presencialSignups PresencialSignup[]

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model AuditLog {
  id        String  @id @default(cuid())
  userId    String?
  action    String // CREATE, UPDATE, DELETE, etc.
  entity    String // Table name
  entityId  String // Record ID
  oldValues Json?
  newValues Json?
  ipAddress String?
  location  String?
  userAgent String?

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model VideoCategory {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  description      String?
  long_description String? @db.Text
  image            String?
  target           String?
  order            Int     @default(0)
  isActive         Boolean @default(true)

  // Multilanguage fields (English versions)
  long_description_en String? @db.Text
  target_en           String?

  // Course modality
  modalidad    String?
  modalidad_en String?

  // What students will learn
  learn    String? @db.Text
  learn_en String? @db.Text

  // What the course includes (structured data)
  includes_category    Json?
  includes_category_en Json?

  // Pricing (a nivel de curso/categoría) - Dual currency
  priceARS         Decimal  @db.Decimal(10, 2)
  priceUSD         Decimal  @db.Decimal(10, 2)
  // Snapshot del precio previo a la promo activa (null si no hay descuento real aplicado).
  // Se usa para restaurar al finalizar la promo sin perder centavos por redondeo.
  originalPriceARS Decimal? @db.Decimal(10, 2)
  originalPriceUSD Decimal? @db.Decimal(10, 2)
  isFree           Boolean  @default(false)

  videos             Video[]
  purchases          CategoryPurchase[]
  cartItems          CartItem[]
  coupons            CouponCategory[]
  chatRooms          ChatRoom[]
  quizAttempts       QuizAttempt[]
  mentorships        Mentorship[]
  mentorshipProducts MentorshipProduct[]
  presencialClasses  PresencialClassCategory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("video_categories")
}

model Video {
  id          String  @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  duration    Int? // Duration in seconds

  // Vimeo Integration
  vimeoId  String
  vimeoUrl String?

  // Organization
  categoryId String
  category   VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  order      Int           @default(0)

  // Status
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // Content
  contenidos String? @db.Text // Video content/syllabus
  downloads  Json? // Downloadable resources

  // SEO
  metaTitle       String?
  metaDescription String?

  // Relations
  views VideoView[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("videos")
}

model CategoryPurchase {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Payment info
  amount        Decimal @db.Decimal(10, 2)
  currency      String  @default("USD")
  paymentMethod String? // "credit_card", "paypal", etc.
  transactionId String? // External payment provider transaction ID
  paymentStatus String  @default("completed") // "pending", "completed", "failed", "refunded"

  // Access control
  expiresAt DateTime? // null = permanent access
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([transactionId])
  @@map("category_purchases")
}

model VideoView {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  // Analytics
  watchedSeconds Int     @default(0)
  totalSeconds   Int?
  progress       Int     @default(0) // Percentage 0-100
  completed      Boolean @default(false)

  // Session info
  ipAddress String?
  userAgent String?
  device    String? // "desktop", "mobile", "tablet"

  lastWatchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, videoId])
  @@map("video_views")
}

model Cart {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id         String        @id @default(cuid())
  cartId     String
  cart       Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  categoryId String
  category   VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Snapshot of prices at the time of adding to cart
  priceARS Decimal @db.Decimal(10, 2)
  priceUSD Decimal @db.Decimal(10, 2)

  addedAt DateTime @default(now())

  @@unique([cartId, categoryId])
  @@map("cart_items")
}

enum PresencialPollStatus {
  draft
  open
  closed
}

model PresencialPoll {
  id          String               @id @default(cuid())
  title       String
  description String?
  status      PresencialPollStatus @default(draft)
  deadlineAt  DateTime?

  // Eligibility stored as JSON: { courseIds: string[], userOverrides: Array<{ userId?: string, email?: string, allowed: boolean }> }
  eligibility Json @default("{\"courseIds\":[],\"userOverrides\":[]}")

  options PresencialPollOption[]
  votes   PresencialVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("presencial_polls")
}

model PresencialPollOption {
  id              String         @id @default(cuid())
  pollId          String
  poll            PresencialPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  date            DateTime // Stored as date only (time will be ignored)
  startTime       String // HH:mm format
  durationMinutes Int            @default(120)

  votes PresencialVote[]

  createdAt DateTime @default(now())

  @@map("presencial_poll_options")
}

model PresencialVote {
  id       String               @id @default(cuid())
  pollId   String
  poll     PresencialPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PresencialPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName String?
  votedAt  DateTime             @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([optionId])
  @@map("presencial_votes")
}

model ProblemReport {
  id          String   @id @default(cuid())
  email       String
  phone       String?
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("problem_reports")
}

// Discount coupons
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  validFrom       DateTime?
  validTo         DateTime?
  maxUses         Int?
  currentUses     Int       @default(0)
  isActive        Boolean   @default(true)
  appliesToAll    Boolean   @default(false)

  // Cupón personal: si userId != null, solo lo puede usar ese usuario.
  userId                 String?
  user                   User?   @relation("UserCoupons", fields: [userId], references: [id], onDelete: Cascade)
  // Si true, no aplica a las formaciones que el usuario ya compró (para "otra formación").
  excludeOwnedCategories Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categories   CouponCategory[]
  consumptions CouponConsumption[]

  @@index([userId])
  @@map("coupons")
}

// Join table: Coupon <-> VideoCategory
model CouponCategory {
  id         String   @id @default(cuid())
  couponId   String
  categoryId String
  createdAt  DateTime @default(now())

  coupon   Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category VideoCategory @relation(fields: [categoryId], references: [id])

  @@unique([couponId, categoryId])
  @@map("coupon_categories")
}

// Tracks coupon consumptions pending payment confirmation
model CouponConsumption {
  id           String    @id @default(cuid())
  couponId     String
  userId       String
  preferenceId String?
  status       String    @default("pending") // pending | confirmed | expired
  consumedAt   DateTime  @default(now())
  expiresAt    DateTime
  confirmedAt  DateTime?

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([status, expiresAt])
  @@map("coupon_consumptions")
}

// ============================================================================
// MENTORÍAS
// ============================================================================

enum MentorshipStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Plantilla de disponibilidad semanal para mentorías (editable desde admin).
/// weekday: 0=Domingo … 1=Lunes … 6=Sábado. start/end en minutos desde 00:00.
model MentorshipAvailability {
  id        String   @id @default(cuid())
  weekday   Int
  startMin  Int
  endMin    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mentorship_availability")
}

/// Reserva de mentoría (una por curso aprobado). Un solo alumno por horario
/// (índice único parcial en la migración). Al pasar el horario → COMPLETED
/// (cron) y recién ahí se activa el chat del curso.
model Mentorship {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  scheduledStart  DateTime
  scheduledEnd    DateTime
  status          MentorshipStatus @default(SCHEDULED)
  rescheduleCount Int              @default(0) // máximo 1 reprogramación

  meetingEmail   String // email elegido para la meet (default = email logueado)
  googleEventId  String?
  googleMeetLink String?

  // null = mentoría gratuita (1 por cuenta). Si viene de un crédito pago,
  // apunta al MentorshipCredit consumido.
  creditId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([scheduledStart])
  @@index([status])
  @@map("mentorships")
}

/// Tipo de producto pago de mentoría/clase.
enum MentorshipProductType {
  MENTORSHIP // mentoría online (se reserva por calendario, consume crédito)
  ONE_TO_ONE // clase presencial one-to-one (se coordina, no usa el calendario)
}

/// Estado de un crédito pago (habilita reservar/coordinar una vez).
enum MentorshipCreditStatus {
  AVAILABLE
  USED
}

/// Producto pago editable desde el admin (mentoría online o clase one-to-one).
/// Cada producto tiene una o más variantes de precio (transferencia, efectivo,
/// exterior en USD, etc.). La validación del pago es MANUAL desde el admin.
model MentorshipProduct {
  id          String                @id @default(cuid())
  categoryId  String?
  category    VideoCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  type        MentorshipProductType @default(MENTORSHIP)
  isActive    Boolean               @default(true)
  sortOrder   Int                   @default(0)

  variants MentorshipPriceVariant[]
  credits  MentorshipCredit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@map("mentorship_products")
}

/// Variante de precio de un producto (ej. "Transferencia" $150.000,
/// "Efectivo" USD 400, "Exterior" USD 150).
model MentorshipPriceVariant {
  id        String            @id @default(cuid())
  productId String
  product   MentorshipProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String // "Transferencia", "Efectivo", "Exterior"
  amount    Decimal           @db.Decimal(10, 2)
  currency  String            @default("ARS") // "ARS" | "USD"
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("mentorship_price_variants")
}

/// Crédito pago otorgado manualmente por el admin tras validar la transferencia.
/// Habilita al alumno a reservar (MENTORSHIP) o a que se coordine (ONE_TO_ONE)
/// una vez. Se consume al reservar la mentoría online.
model MentorshipCredit {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String?
  product      MentorshipProduct?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId   String?
  type         MentorshipProductType  @default(MENTORSHIP)
  amount       Decimal?               @db.Decimal(10, 2)
  currency     String? // "ARS" | "USD"
  note         String?
  status       MentorshipCreditStatus @default(AVAILABLE)
  mentorshipId String? // mentoría online que consumió el crédito
  grantedById  String? // admin que lo otorgó

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([categoryId])
  @@map("mentorship_credits")
}

// ============================================================================
// Clases presenciales: fechas tentativas que abre el admin (hasta 6 meses),
// inscripción libre (1 activa por alumna) y confirmación posterior con aviso.
// ============================================================================

enum PresencialClassStatus {
  TENTATIVE // fecha estimativa, puede cambiar
  CONFIRMED // confirmada por el admin (se avisa a las inscriptas)
  CANCELLED
  COMPLETED // ya pasó (cron)
}

enum PresencialSignupStatus {
  PENDING // anotada, esperando confirmación
  CONFIRMED
  REJECTED // el admin no le dio lugar
  CANCELLED // la alumna se bajó (o se canceló la clase)
  COMPLETED // la clase ya pasó (cron)
}

/// Clase presencial. startAt/endAt se calculan de la fecha + horas (09–18, hora
/// Argentina). Puede haber más de una el mismo día (ej. Estilismo 14–18 y
/// Tatuaje 10–18). Las inscriptas NO ven cuántas hay; el admin sí.
model PresencialClass {
  id          String                @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  startHour   Int // 9..17
  endHour     Int // 10..18
  status      PresencialClassStatus @default(TENTATIVE)
  // Si está activo, solo se anotan alumnas con compra activa de alguna de las
  // formaciones de la clase. Por defecto la inscripción es libre.
  restrictToStudents Boolean   @default(false)
  confirmedAt        DateTime?

  categories PresencialClassCategory[]
  signups    PresencialSignup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([status])
  @@map("presencial_classes")
}

/// Formaciones a las que aplica una clase presencial (N:N).
model PresencialClassCategory {
  classId    String
  class      PresencialClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  categoryId String
  category   VideoCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([classId, categoryId])
  @@index([categoryId])
  @@map("presencial_class_categories")
}

/// Inscripción de una alumna a una clase presencial. Máximo 1 activa
/// (PENDING/CONFIRMED) por alumna — índice único parcial en la migración.
model PresencialSignup {
  id      String                 @id @default(cuid())
  classId String
  class   PresencialClass        @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId  String
  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  PresencialSignupStatus @default(PENDING)
  note    String?
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, userId])
  @@index([userId])
  @@index([status])
  @@map("presencial_signups")
}

// ============================================================================
// CHAT
// ============================================================================

enum ChatRoomStatus {
  LOCKED // compra activa pero progreso de videos < 95%
  ACTIVE // desbloqueado: alumno y admin pueden chatear
  GRACE // compra expiró, dentro de 90 días post-expiración, sigue activo
  CLOSED // pasaron los 90 días de gracia → solo lectura
}

enum ChatMessageType {
  TEXT
  IMAGE
}

enum ChatSenderRole {
  STUDENT
  ADMIN
}

model ChatRoom {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  status         ChatRoomStatus @default(LOCKED)
  unlockedAt     DateTime? // primera vez que pasó a ACTIVE
  gracePeriodEnd DateTime? // expiresAt + 90 días (solo si aplica)

  // First student message marker (para enviar email una sola vez)
  studentInitiated Boolean @default(false)

  // Read tracking (1-a-1: sabemos quién leyó hasta cuándo)
  lastMessageAt     DateTime?
  lastStudentReadAt DateTime?
  lastAdminReadAt   DateTime?

  // Bloqueo manual del chat por parte del admin. Cuando blocked=true el alumno
  // no puede enviar mensajes nuevos (solo lectura); el admin puede desbloquear.
  blocked   Boolean   @default(false)
  blockedAt DateTime?

  // Fin de vida del chat: se setea al desbloquearse (unlockedAt + días de vida,
  // setting "chat.lifetimeDays", default 30). Al vencer pasa a CLOSED. El admin
  // puede extenderlo y comprar otra formación lo reabre.
  expiresAt DateTime?

  // DEPRECADO: sistema de tokens reemplazado por `blocked`. Se conservan las
  // columnas para no perder historial; no se usan más.
  tokens          Int       @default(0)
  tokensBlockedAt DateTime?

  messages    ChatMessage[]
  tokenEvents ChatTokenEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("chat_rooms")
}

/// Historial de tokens marcados por el admin en una sala de chat.
model ChatTokenEvent {
  id      String   @id @default(cuid())
  roomId  String
  room    ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  adminId String
  admin   User     @relation("ChatTokenEventAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  amount       Int // delta aplicado (+1, +3, -1…). 0 no se registra.
  balanceAfter Int // tokens de la sala luego del movimiento
  reason       String? @db.Text

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("chat_token_events")
}

// ============================================================================
// CONFIGURACIÓN (key/value editable desde el panel admin)
// ============================================================================

model AppSetting {
  key         String   @id
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("app_settings")
}

/// Respuestas rápidas reutilizables que el admin inserta en el chat de un alumno.
/// Son globales (compartidas por todos los admins/subadmins).
model ChatQuickReply {
  id    String @id @default(cuid())
  title String
  body  String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@map("chat_quick_replies")
}

// ============================================================================
// QUIZ (examen final — mismo examen para todos los cursos, gate del chat)
// ============================================================================

model QuizAttempt {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Respuestas enviadas: { [questionId]: boolean } (true = Verdadero)
  answers          Json
  // IDs de preguntas respondidas mal (se muestran al alumno, sin explicación)
  wrongQuestionIds Json
  correctCount     Int
  totalQuestions   Int
  passed           Boolean

  createdAt DateTime @default(now())

  @@index([userId, categoryId, createdAt])
  @@map("quiz_attempts")
}

model ChatMessage {
  id         String         @id @default(cuid())
  roomId     String
  room       ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole ChatSenderRole

  type     ChatMessageType @default(TEXT)
  content  String?         @db.Text
  imageUrl String?
  imageKey String? // key en DO Spaces, para poder borrar si hace falta

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// ============ Public Form Builder ============

enum FormStatus {
  draft
  published
  closed
}

model Form {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String?    @db.Text
  status      FormStatus @default(draft)

  // Field definitions as JSON array: Array<{ id, type, label, description?, placeholder?, required?, options?: [{id,label}], allowContext?, contextLabel? }>
  fields Json @default("[]")

  successMessage String? @db.Text
  closedMessage  String? @db.Text
  submitLabel    String?

  responses FormResponse[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@map("forms")
}

model FormResponse {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  // { [fieldId]: string | string[] | { value: boolean, context?: string } }
  answers   Json
  // Email extraído del primer campo tipo "email" (normalizado lowercase) para dedup
  email     String?
  ipAddress String?
  userAgent String?

  // pending | accepted | rejected — decisión de acceso/invitación al evento
  status           String    @default("pending")
  invitationSentAt DateTime?

  createdAt DateTime @default(now())

  @@unique([formId, email])
  @@index([formId, createdAt])
  @@index([formId, status])
  @@map("form_responses")
}
