# Database
DATABASE_URL="postgresql://username:password@localhost:5432/mery_portal?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Application
PORT=3000
NODE_ENV="development"

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PASSWORD="admin123"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Brevo (Email Service)
BREVO_API_KEY="your-brevo-api-key"
EMAIL_FROM="noreply@merygarcia.com"
FRONTEND_URL="http://localhost:3000"

# Vimeo Integration
VIMEO_CLIENT_ID="your-vimeo-client-id"
VIMEO_CLIENT_SECRET="your-vimeo-client-secret"
VIMEO_ACCESS_TOKEN="your-vimeo-access-token"

# Problem reports via Pistech WhatsApp API
# Reportes de problemas -> panel de ayuda de Pistech (token del proyecto Mery-Portal)
PISTECH_REPORT_ENDPOINT="https://whatsapp-pistech-neonize-production.up.railway.app"
PISTECH_REPORT_TOKEN=""

# DigitalOcean Spaces (storage para imágenes del chat)
# Endpoint debe incluir protocolo: https://nyc3.digitaloceanspaces.com
DO_SPACES_ENDPOINT=""
DO_SPACES_REGION="us-east-1"
DO_SPACES_BUCKET=""
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
# Opcional: URL base del CDN (si tenés uno configurado), ej. https://cdn.merygarcia.com
# Si queda vacío se usa el endpoint público del bucket.
DO_SPACES_CDN_URL=""

# Señas de clases presenciales
# Backend de mery-garcia: expone GET /dolar/cotizacion (dólar blue) para convertir
# las señas en USD a pesos. Si queda vacío, se usa siempre el dólar fijo del panel.
MERY_GARCIA_API_URL=
# URL pública del webhook de MP para las preferences que arma este backend.
# Si queda vacío se usa la que esté configurada en el panel de Mercado Pago.
MP_WEBHOOK_URL=
